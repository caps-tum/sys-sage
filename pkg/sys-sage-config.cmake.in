@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# expose the options of the build configuration
set(sys-sage-INTEL_PQOS @INTEL_PQOS@)
set(sys-sage-NVIDIA_MIG @NVIDIA_MIG@)
set(sys-sage-PROC_CPUINFO @PROC_CPUINFO@)
set(sys-sage-DS_HWLOC @DS_HWLOC@)
set(sys-sage-DS_MT4G @DS_MT4G@)
set(sys-sage-DS_NUMA @DS_NUMA@)
set(sys-sage-QDMI @QDMI@)
set(sys-sage-PAPI @PAPI@)

find_dependency(LibXml2)
find_dependency(nlohmann_json 3.10)

# dependencies for options like DS_HWLOC and DS_NUMA don't need to be enforced to the user, since they are only needed for the data source binaries
# -> exclude them from here

if(sys-sage-NVIDIA_MIG)
    find_dependency(CUDAToolkit 10.0)
endif()

if(sys-sage-QDMI)
    find_dependency(backends)
    find_dependency(qinfo)
endif()

if(sys-sage-PAPI)
    find_dependency(PAPI)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/sys-sage-targets.cmake")

check_required_components(sys-sage)
